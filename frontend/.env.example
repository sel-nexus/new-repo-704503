# Same-origin prefix; slash means origin root, not an /api prefix.
VITE_API_BASE_URL=/
# Deadline for a user-triggered check in milliseconds.
VITE_HEALTH_TIMEOUT_MS=5000
# Development-only API proxy (never included in the client bundle).
DEV_API_PROXY_TARGET=http://127.0.0.1:3001
# Development listener address and port.
DEV_HOST=0.0.0.0
DEV_PORT=5173
