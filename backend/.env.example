# Local runtime; container environments override these values.
NODE_ENV=development
# Bind address for the HTTP listener.
HOST=0.0.0.0
# Backend listener port.
PORT=3001
# Comma-separated allowed browser origins; blank disables cross-origin access.
CORS_ORIGINS=http://localhost:5173
# File URL reserved for the next SQLite slice (Node 24 built-in SQLite).
DATABASE_URL=file:./data/starter.db
