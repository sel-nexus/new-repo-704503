{
  "name": "starter-backend",
  "version": "1.0.0",
  "private": true,
  "engines": { "node": ">=24 <25" },
  "scripts": {
    "dev": "node node_modules/ts-node-dev/bin/ts-node-dev --files --respawn src/index.ts",
    "build": "node node_modules/typescript/bin/tsc",
    "start": "node dist/index.js",
    "test": "node node_modules/vitest/vitest.mjs run"
  },
  "dependencies": {
    "cors": "2.8.5",
    "dotenv": "16.6.1",
    "express": "4.22.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/cors": "2.8.19",
    "@types/express": "4.17.21",
    "@types/node": "24.0.10",
    "@types/supertest": "6.0.3",
    "supertest": "7.1.4",
    "ts-node-dev": "2.0.0",
    "typescript": "5.8.3",
    "vitest": "4.1.12"
  }
}
